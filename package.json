{
  "name": "adnotia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "description": "Free, open-source, evidence-based tools for adults with ADHD and for parents of children who may have it. Everything runs in the browser.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:single": "vite build --mode single && node scripts/finish-single.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && node scripts/check-no-network.mjs && node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@types/node": "^24.13.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
